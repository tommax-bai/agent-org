{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-org/schemas/pm_dispatch_plan.schema.json",
  "title": "PMDispatchPlan",
  "description": "PM 输出的 dispatch_plan(v2.4:role_sequence 结构)",
  "type": "object",
  "required": [
    "parsed_intent",
    "assumptions",
    "complexity",
    "business_breakdown",
    "role_dispatch_notes",
    "confidence"
  ],
  "additionalProperties": false,
  "properties": {
    "parsed_intent": {"type": "string", "minLength": 1},
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "content", "risk"],
        "properties": {
          "id": {"type": "string"},
          "content": {"type": "string"},
          "risk": {"type": "string", "enum": ["low", "medium", "high"]}
        }
      }
    },
    "complexity": {
      "type": "object",
      "required": ["level"],
      "properties": {
        "level": {"type": "string", "enum": ["low", "medium", "high"]},
        "reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "business_breakdown": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["subtask_id", "description", "task_type", "role_sequence"],
        "additionalProperties": false,
        "properties": {
          "subtask_id": {"type": "string", "pattern": "^subtask-[0-9]+$"},
          "description": {"type": "string", "minLength": 1},
          "task_type": {"type": "string"},
          "success_criteria": {"type": "array", "items": {"type": "string"}},
          "role_sequence": {
            "type": "array",
            "minItems": 1,
            "description": "v2.4:替代 required_roles。顺序由 step 决定,list 位置无语义",
            "items": {
              "type": "object",
              "required": ["step", "role_id"],
              "additionalProperties": false,
              "properties": {
                "step": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "从 1 起,在同一 subtask 内必须连续,不允许跳号/重复(validator 强制)"
                },
                "role_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
              }
            }
          },
          "dependencies": {
            "type": "array",
            "items": {"type": "string", "pattern": "^subtask-[0-9]+$"}
          }
        }
      }
    },
    "role_dispatch_notes": {
      "type": "array",
      "description": "PM 偏离 role_groups 模板时必须说明",
      "items": {
        "type": "object",
        "required": ["subtask_id", "deviation_type", "role_id", "reason"],
        "properties": {
          "subtask_id": {"type": "string"},
          "deviation_type": {
            "type": "string",
            "enum": ["add_role", "remove_role", "template_default"]
          },
          "role_id": {"type": "string"},
          "reason": {"type": "string"},
          "policy_rule_id": {"type": "string"}
        }
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
