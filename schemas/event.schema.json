{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-org/schemas/event.schema.json",
  "title": "Event",
  "description": "task_events 表 / events.jsonl 一条事件(v2.4 事件类型)",
  "type": "object",
  "required": ["time", "task_id", "type", "actor"],
  "additionalProperties": false,
  "properties": {
    "time": {"type": "string", "format": "date-time"},
    "task_id": {"type": "string"},
    "type": {
      "type": "string",
      "enum": [
        "TASK_CREATED",
        "STATE_CHANGED",
        "DISPATCH_DECISION",
        "ROLE_INVOKED",
        "ROLE_RETURNED",
        "SIGNAL_RECEIVED",
        "BUDGET_CONSUMED",
        "ESCALATED",
        "TASK_COMPLETED",
        "TASK_FAILED",
        "PLAN_RETRY_REQUESTED",
        "PLAN_VALIDATION_FATAL",
        "ATTEMPT_LIMIT_REACHED",
        "IMMEDIATE_ESCALATE_TRIGGERED",
        "IMMEDIATE_ESCALATE_REJECTED",
        "ARTIFACT_VALIDATION_FAILED"
      ],
      "description": "v2.4:删除 PLAN_AUTOFIXED;新增 PLAN_RETRY_REQUESTED / PLAN_VALIDATION_FATAL / ATTEMPT_LIMIT_REACHED"
    },
    "actor": {"type": "string"},
    "payload": {"type": "object"}
  }
}
