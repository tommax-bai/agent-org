{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-org/schemas/artifact_content/analysis.schema.json",
  "title": "AnalysisArtifactContent",
  "description": "通用 analysis 类型(给新角色的 starter,不鼓励长期用——稳定后应该定义自己的 type + schema)",
  "type": "object",
  "required": ["content_text"],
  "additionalProperties": false,
  "properties": {
    "content_text": {"type": "string", "minLength": 1},
    "structured": {
      "type": "object",
      "description": "可选:角色特定的结构化字段"
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
