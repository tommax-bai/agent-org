# 复制到 .env(不进 git)然后改

# ---- Postgres ----
POSTGRES_USER=agent
POSTGRES_PASSWORD=change_this_to_a_random_strong_password

# ---- Langfuse ----
# 随机字符串。生成方法:openssl rand -base64 32
LANGFUSE_NEXTAUTH_SECRET=change_this_to_random_base64
LANGFUSE_SALT=change_this_to_random_base64

# ---- agent-org runtime ----
# 哪个 LLM provider
DASHSCOPE_API_KEY=
ANTHROPIC_API_KEY=

# event_log / artifact 后端切换(file = 0B 行为,postgres = 0C+)
STORAGE_BACKEND=file
# 配 postgres 时还需要:
DATABASE_URL=postgresql://agent:change_this_to_a_random_strong_password@127.0.0.1:5432/agent_org

# Langfuse 上报(空 = 不上报)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
